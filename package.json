{
  "name": "big-question-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "npm run build:client && vite dev",
    "build": "npm run build:client && vite build",
    "build:client": "vite build --config vite.client.config.ts",
    "generate:icons": "node scripts/generate-icons.mjs",
    "db:migrate:auth": "wrangler d1 migrations apply big-question-club-auth --remote",
    "db:migrate:local": "wrangler d1 migrations apply big-question-club-auth --local",
    "db:migrate:remote": "wrangler d1 migrations apply big-question-club-auth --remote",
    "db:schema:check": "drizzle-kit check",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:d1": "vitest run --config vitest.d1.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "latest",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "hono": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.3",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "latest",
    "prettier": "latest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
